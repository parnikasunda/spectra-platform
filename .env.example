# Argus Anti-Piracy Intelligence & Evidence Platform Configuration

# Server Port (default 3000)
PORT=3000

# SQLite Database Path
DATABASE_PATH="./data/argus.db"

# Media Storage Directory for extracted frames and uploaded reference media
MEDIA_STORAGE_PATH="./data/media"

# Perceptual Hashing Sensitivity Threshold (Hamming Distance 0-64; default 10)
FINGERPRINT_HAMMING_THRESHOLD=10

# Temporal Sampling Interval in seconds (default 2s)
FINGERPRINT_SAMPLE_INTERVAL_SEC=2

# Optional Gemini API Key for advanced content categorization (if configured)
GEMINI_API_KEY=""

# Host Application URL
APP_URL="http://localhost:3000"
